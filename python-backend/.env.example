# ModelScope API Keys，逗号分隔
# 格式: ms- 开头的完整 key
MODELSCOPE_KEYS=ms-your_key_1,ms-your_key_2,ms-your_key_3

# 每把 Key 每天的调用上限
DAILY_LIMIT=200

# 代理监听端口
PROXY_PORT=8000

# 日志级别: DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# ModelScope API 地址
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# 默认模型（客户端不传 model 时使用）
DEFAULT_MODEL=deepseek-ai/DeepSeek-V4-Pro
